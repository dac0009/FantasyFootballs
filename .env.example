# Copy to .env and fill in real values. .env is gitignored and must NEVER be committed.
# How to get these: log in to fantasy.espn.com, open DevTools -> Application -> Cookies
# -> https://fantasy.espn.com, and copy the two cookies below. See docs/SECURITY.md.

SWID={00000000-0000-0000-0000-000000000000}
ESPN_S2=replace_me_with_your_espn_s2_cookie_value
